# Copy to .env and fill in real values. Never commit .env.

# Claude Artifact publishing (Phase 3 frontend sync)
CLAUDE_API_KEY=
CLAUDE_ARTIFACT_ID=

# Logging
LOG_LEVEL=info

# Scraper behavior
CRAWL_DELAY_MS=8000
MAX_CONCURRENT_SCRAPERS=3
USER_AGENT=india-gcc-board-bot/1.0 (+https://github.com/vikram-git-vault/india-gcc-board)

# Timezone (used by refresh.js and cron)
TZ=Asia/Kolkata

# Database
DB_PATH=./data/jobs.db

# Optional notifications
SLACK_WEBHOOK=
