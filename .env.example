# Copy to .env and fill in real values. Never commit .env.

# Self-hosted server (server.js)
PORT=4000
# 127.0.0.1: only this computer can open the board (safest).
# 0.0.0.0: other devices on the network can open it too (docs/SETUP.md §7).
HOST=127.0.0.1
# Extra host names that can open the board, comma-separated, for example
# your Tailscale name (board.tailXXXX.ts.net). localhost and IP addresses
# are always allowed. Other names get 403 (protects against DNS rebinding).
# A name without a port allows any port; name:port allows only that port.
ALLOWED_HOSTS=
# 6-field-free cron expression (node-cron), evaluated in TZ below.
REFRESH_CRON=0 6 * * *
# Time limit for one employer during a refresh, in minutes
EMPLOYER_TIME_LIMIT_MINUTES=20
# Number of employers that the refresh scrapes at the same time (1 to 16)
SCRAPE_CONCURRENCY=6
# Score new roles with Claude Code after each refresh (on or off)
AUTO_SCORE=on

# Logging
LOG_LEVEL=info

# Scraper behavior
CRAWL_DELAY_MS=8000
USER_AGENT=india-gcc-board-bot/1.0 (+https://github.com/vikram-git-vault/india-gcc-board)

# Timezone (used by refresh.js and cron)
TZ=Asia/Kolkata

# Database
DB_PATH=./data/jobs.db

# Optional notifications
SLACK_WEBHOOK=
