# Copy to .env and fill in real values. Never commit .env.
#
# .env holds only values that must not be in git: secrets and private
# host names. Every other setting is in config/settings.json (committed;
# lib/settings.js has the default of each property). docs/SETUP.md §2.

# Extra host names that can open the board, comma-separated, for example
# your Tailscale name (board.tailXXXX.ts.net). localhost and IP addresses
# are always allowed. Other names get 403 (protects against DNS rebinding).
# A name without a port allows any port; name:port allows only that port.
# Private: a Tailscale name identifies your network.
ALLOWED_HOSTS=

# Optional notifications (secret). The GitHub workflow reads it from the
# repository secrets; no local code reads it yet.
SLACK_WEBHOOK=
