# Copy to .env and fill in real values. Never commit .env.

# Self-hosted server (server.js)
PORT=4000
HOST=0.0.0.0
# 6-field-free cron expression (node-cron), evaluated in TZ below.
REFRESH_CRON=0 6 * * *
# Time limit for one employer during a refresh, in minutes
EMPLOYER_TIME_LIMIT_MINUTES=20
# Score new roles with Claude Code after each refresh (on or off)
AUTO_SCORE=on

# Logging
LOG_LEVEL=info

# Scraper behavior
CRAWL_DELAY_MS=8000
MAX_CONCURRENT_SCRAPERS=3
USER_AGENT=india-gcc-board-bot/1.0 (+https://github.com/vikram-git-vault/india-gcc-board)

# Timezone (used by refresh.js and cron)
TZ=Asia/Kolkata

# Database
DB_PATH=./data/jobs.db

# Optional notifications
SLACK_WEBHOOK=
