# Copy to .env and fill in real values. Never commit .env.

# Frontend sync (Phase 3) — informational only, not used for auth.
# There is no public API for a script to push into a published Artifact's
# database; refresh.js just writes data/artifact-sync.json, and syncing it
# to the live board is a manual step from a Claude Code session (see
# docs/ARCHITECTURE.md §5.1). This URL is only for that step's own reference.
ARTIFACT_URL=https://claude.ai/code/artifact/35691137-5630-4af7-a06c-72cd225e065c

# Logging
LOG_LEVEL=info

# Scraper behavior
CRAWL_DELAY_MS=8000
MAX_CONCURRENT_SCRAPERS=3
USER_AGENT=india-gcc-board-bot/1.0 (+https://github.com/vikram-git-vault/india-gcc-board)

# Timezone (used by refresh.js and cron)
TZ=Asia/Kolkata

# Database
DB_PATH=./data/jobs.db

# Optional notifications
SLACK_WEBHOOK=
